# Safe configuration template. Do not put real secrets in this example.
# Copy to .env for personal notes/configuration; .env is excluded from Git.
# The app currently DOES NOT load .env automatically.
# To apply settings, set environment variables before launching the app.
# macOS: export TELEMED_OLLAMA_MODEL=qwen3:4b
# PowerShell: $env:TELEMED_OLLAMA_MODEL = "qwen3:4b"
TELEMED_OLLAMA_MODEL=qwen3:4b

# For direct client execution only. The launcher sets its own local URL
# according to --ollama-port (default 11435).
TELEMED_OLLAMA_URL=http://127.0.0.1:11435

# Local Whisper and Ollama do not require API keys or passwords.
